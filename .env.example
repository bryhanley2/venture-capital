# ---- Frontend (Vite, safe to expose) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SITE_PASSWORD=choose-a-site-password
# Shared secret the browser sends to the /api routes. Must equal APP_TOKEN below.
VITE_APP_TOKEN=choose-a-long-random-string

# ---- Serverless only (set in Vercel Project Settings, never exposed) ----
# Gate for /api/dealflow and /api/company-check. Must equal VITE_APP_TOKEN.
APP_TOKEN=choose-a-long-random-string
# Anthropic key for the "check a company" agent (one web-search pass, ~$0.05/call).
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override for the agent (defaults to claude-sonnet-5).
PIPELINE_MODEL=claude-sonnet-5
# Read-only Google service account JSON (single line) with access to the pipeline sheet.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# The pipeline's output spreadsheet ID (from its URL).
GOOGLE_SHEET_ID=your_sheet_id
